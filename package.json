{
  "name": "campusconnect",
  "version": "1.0.0",
  "description": "Smart Event Management System - Software Construction Project",
  "main": "dist/index.js",
  "scripts": {
    "generate-parser": "peggy --format commonjs -o src/query/parser-generated.js src/query/query.peggy",
    "prebuild": "npm run generate-parser",
    "build": "tsc",
    "test": "jest",
    "start": "npm run build && node dist/server.js",
    "dev": "npm run generate-parser && tsc && node dist/server.js",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "event-management",
    "typescript",
    "software-construction"
  ],
  "author": "Team CampusConnect",
  "license": "MIT",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.27",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^9.0.0",
    "jest": "^29.7.0",
    "peggy": "^5.0.6",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "sql.js": "^1.10.3",
    "uuid": "^9.0.0"
  }
}
